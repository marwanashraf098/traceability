#!/usr/bin/env bash
# Lookup-adjust repair, 2026-10-10 (D10). EXACTLY two pieces of The Snouts whose Lookup adjustments on
# 2026-10-10 never reached Shopify:
#   01M3S6YXH3Z0PCC6J6467HPR0T  voided  → −1 at the main warehouse (pushVoidCorrection, new claim
#                                          void_correction <piece>:repair-2026-10-10; the old 'skipped' row stays)
#   01M3S6YXH3VPJ3FDXA4RTN9N9P  damaged → the fixed available → damaged move (new claim
#                                          damage_move <piece>:repair-2026-10-10; the old 'failed' row → superseded_by_repair)
# Logic: LookupAdjustRepairService (POST /api/v1/ops/repair/lookup-adjust-2026-10-10/{tenant}).
#
# DRY RUN BY DEFAULT: prints Shopify's current available / damaged / on_hand for both variants, the
# intended deltas and what would be claimed — writes nothing, sends nothing to Shopify.
# --apply claims and sends each correction ONCE (idempotent: a second --apply claims nothing).
# Run --apply ONLY after Marawan has confirmed the dry-run output.
#
# Usage:  TRACED_API=https://app.tracedtech.com TRACED_OPS_SECRET=... scripts/repair-lookup-adjust-2026-10-10 [--apply]
set -euo pipefail

TENANT_ID="e785e5e4-2c5c-428e-afdd-d26d90754229"   # The Snouts
APPLY=false
for arg in "$@"; do
  case "$arg" in
    --apply) APPLY=true ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

: "${TRACED_API:?set TRACED_API (e.g. https://app.tracedtech.com)}"
: "${TRACED_OPS_SECRET:?set TRACED_OPS_SECRET}"

if [ "$APPLY" = true ]; then
  echo ">>> APPLY: claiming and sending the two corrections for tenant $TENANT_ID"
else
  echo ">>> DRY RUN (nothing is written, nothing is sent). Pass --apply to repair."
fi

curl -sS --fail-with-body -X POST \
  -H "X-Ops-Secret: ${TRACED_OPS_SECRET}" \
  "${TRACED_API%/}/api/v1/ops/repair/lookup-adjust-2026-10-10/${TENANT_ID}?apply=${APPLY}" \
  | python3 -m json.tool
