exports[`Put-away list — capability off > off screens render as on main and never ask /put-away > off: finalized receipt 1`] = `"<div class="space-y-4"><button class="text-small text-trace-blue hover:text-trace-blue-hover transition-colors">← Back to Sessions</button><div class="flex items-start justify-between"><div><h1 class="text-h1 text-primary">PO-118</h1><p class="text-small text-muted mt-0.5 flex items-center gap-2">Main Warehouse · <span class="badge border bg-success/[0.14] text-success-text border-success/[0.30]">finalized</span><span data-testid="receiving-session-mode"><span class="badge border bg-muted/[0.14] text-neutral-text border-muted/[0.30]">Label now</span></span></p></div><div class="flex gap-2"><button type="button" class="btn rounded-xl transition-colors bg-trace-blue hover:bg-trace-blue-hover hover:shadow-glow active:bg-trace-blue-active active:shadow-none text-white px-3 py-1.5 text-small gap-1.5">Print Labels (4)</button><button type="button" class="btn rounded-xl transition-colors bg-transparent border border-line text-primary hover:bg-elevated hover:border-grey-300 active:bg-charcoal px-3 py-1.5 text-small gap-1.5">Reprint</button></div></div><div class="card overflow-hidden"><table class="min-w-full"><thead><tr class="border-b border-line"><th class="tbl-header">Product / Variant</th><th class="tbl-header">SKU</th><th class="tbl-header text-end">Qty</th><th class="tbl-header w-8"></th></tr></thead><tbody><tr><td colspan="4" class="px-4 py-8 text-center text-small text-muted">No items added yet</td></tr></tbody></table></div><p class="text-small text-muted">4 pieces created · Finalized at 10/30/2026, 11:00:00 AM</p></div><div class="fixed bottom-4 end-4 z-dropdown flex flex-col gap-2 pointer-events-none"></div>"`;

exports[`Put-away list — capability off > off screens render as on main and never ask /put-away > off: tag stock summary 1`] = `"<div class="space-y-4" data-testid="tag-stock-summary"><div><h1 class="text-h1 text-primary">Session summary</h1><p class="text-small text-muted mt-0.5">3 pieces tagged</p></div><div class="card overflow-hidden"><table class="min-w-full"><thead><tr class="border-b border-line"><th class="tbl-header">Product</th><th class="tbl-header text-end">Printed</th><th class="tbl-header text-end">Tagged</th><th class="tbl-header text-end">Labels not used</th></tr></thead><tbody><tr><td colspan="4" class="px-4 py-8 text-center text-small text-muted">Nothing was printed or tagged in this session.</td></tr></tbody></table></div><div class="flex flex-wrap gap-2"><button type="button" class="btn rounded-xl transition-colors bg-trace-blue hover:bg-trace-blue-hover hover:shadow-glow active:bg-trace-blue-active active:shadow-none text-white px-4 py-2 text-body">Back to Tag stock</button></div></div><div class="fixed bottom-4 end-4 z-dropdown flex flex-col gap-2 pointer-events-none"></div>"`;

exports[`Put-away list — capability off > off screens render as on main and never ask /put-away > off: transfer reconcile 1`] = `"<div class="space-y-4"><button class="text-small text-trace-blue hover:text-trace-blue-hover transition-colors">← Back to Transfer</button><div class="flex items-center justify-between flex-wrap gap-3"><h1 class="text-h1 text-primary flex items-center gap-2">Reconcile<span class="badge border bg-warning/[0.14] text-warning-text border-warning/[0.30]">Showroom</span></h1><div class="flex items-center gap-4"><button type="button" data-testid="tour-help" aria-label="Show the tour for this page" title="Show the tour for this page" class="w-9 h-9 flex-shrink-0 rounded-full border border-line bg-surface text-muted hover:text-primary hover:bg-elevated inline-flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-question-mark" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg></button><div class="text-end"><p class="text-caption uppercase tracking-widest text-muted">Outstanding pieces</p><p class="text-h2 font-mono text-success" data-testid="reconcile-outstanding">0</p></div></div></div><div data-tour-anchor="transfers-reconcile"><div class="card p-5 space-y-3"><div class="flex items-center justify-between flex-wrap gap-2"><h2 class="text-body font-semibold text-primary">Scan Back</h2><div class="flex items-center gap-2"><span class="text-small text-muted">Condition</span><button type="button" data-testid="condition-good-btn" class="px-4 py-2 rounded-lg text-small font-semibold border transition-colors bg-success text-white border-success">Good</button><button type="button" data-testid="condition-condemned-btn" class="px-4 py-2 rounded-lg text-small font-semibold border transition-colors border-line text-muted hover:border-danger">Condemned</button></div></div><div class="hidden"></div><div class="relative"><input type="text" placeholder="Scan returned piece…" class="input-scan w-full" aria-busy="false"></div></div></div><div class="card p-5 space-y-3"><h2 class="text-body font-semibold text-primary">Lines — live balance</h2><div class="overflow-x-auto"><table class="min-w-full"><thead><tr class="border-b border-line"><th class="tbl-header">Variant / SKU</th><th class="tbl-header">Sent Out</th><th class="tbl-header">Accounted For</th><th class="tbl-header">Outstanding</th><th class="tbl-header">Sold</th><th class="tbl-header">Lost</th><th class="tbl-header">Condemned (not returned)</th><th class="tbl-header"></th></tr></thead><tbody><tr class="tbl-row align-top"><td class="tbl-cell text-primary">Black T-shirt · M<span class="font-mono text-caption text-muted ms-2">SKU-v1</span></td><td class="tbl-cell text-primary">3</td><td class="tbl-cell text-muted">3</td><td class="tbl-cell"><span class="badge border bg-success/[0.14] text-success-text border-success/[0.30]">Balanced</span></td><td class="tbl-cell"><div class="flex flex-col gap-1 w-full"><div class="relative w-full"><input data-testid="shortfall-sold-tl1" type="number" min="0" disabled="" class="input w-16" value=""></div></div></td><td class="tbl-cell"><div class="flex flex-col gap-1 w-full"><div class="relative w-full"><input data-testid="shortfall-lost-tl1" type="number" min="0" disabled="" class="input w-16" value=""></div></div></td><td class="tbl-cell"><div class="flex flex-col gap-1 w-full"><div class="relative w-full"><input data-testid="shortfall-condemnedNotReturned-tl1" type="number" min="0" disabled="" class="input w-16" value=""></div></div></td><td class="tbl-cell"><button type="button" disabled="" class="btn rounded-xl transition-colors bg-transparent border border-line text-primary hover:bg-elevated hover:border-grey-300 active:bg-charcoal px-3 py-1.5 text-small gap-1.5">Apply</button></td></tr></tbody></table></div></div><div class="card p-5 flex items-center justify-between flex-wrap gap-3"><div></div><button type="button" class="btn rounded-xl transition-colors bg-critical hover:bg-[#B91C1C] active:bg-[#991B1B] text-white px-4 py-2 text-body">Close Transfer</button></div></div><div class="fixed bottom-4 end-4 z-dropdown flex flex-col gap-2 pointer-events-none"></div>"`;

exports[`Put-away list — capability off > off screens render as on main and never ask /put-away > off: transfer send-out 1`] = `"<div class="flex flex-col h-screen bg-base" data-testid="transfer-scan-out"><div class="bg-panel border-b border-line px-6 py-3 flex items-center justify-between gap-3"><button type="button" class="btn rounded-xl transition-colors text-trace-blue bg-transparent hover:bg-trace-blue/10 hover:text-trace-blue-hover active:bg-trace-blue/[0.18] active:text-trace-blue-active px-3 py-1.5 text-small gap-1.5">← Back</button><div class="flex items-center gap-3 min-w-0"><button type="button" data-testid="tour-help" aria-label="Show the tour for this page" title="Show the tour for this page" class="w-9 h-9 flex-shrink-0 rounded-full border border-line bg-surface text-muted hover:text-primary hover:bg-elevated inline-flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-question-mark" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg></button><div class="text-end min-w-0"><p class="text-body font-medium text-primary">Showroom</p><p class="text-caption text-muted">Showroom</p></div></div></div><div class="bg-panel border-b border-line px-6 py-4" data-tour-anchor="transfers-scan"><div class="hidden"></div><div class="relative"><input type="text" placeholder="Scan piece barcode…" class="input-scan w-full" aria-busy="false"></div></div><div class="flex-1 overflow-y-auto p-6 space-y-6"><div class="space-y-2"><h2 class="text-caption text-muted uppercase tracking-widest">Send-out progress</h2><div class="card overflow-hidden"><table class="min-w-full"><tbody><tr class="tbl-row"><td class="tbl-cell text-primary">Black T-shirt · M<span class="font-mono text-caption text-muted ms-2">SKU-v1</span></td><td class="tbl-cell text-end font-mono text-h3 text-primary">3</td></tr></tbody></table></div></div><div class="space-y-2"><h2 class="text-caption text-muted uppercase tracking-widest">Recent scans</h2><p class="text-small text-muted">No scans yet</p></div></div><div class="bg-panel border-t border-line px-6 py-4"><button type="button" class="btn rounded-xl transition-colors bg-trace-blue hover:bg-trace-blue-hover hover:shadow-glow active:bg-trace-blue-active active:shadow-none text-white px-4 py-2 text-body w-full">Done — View Transfer</button></div></div><div class="fixed bottom-4 end-4 z-dropdown flex flex-col gap-2 pointer-events-none"></div>"`;
