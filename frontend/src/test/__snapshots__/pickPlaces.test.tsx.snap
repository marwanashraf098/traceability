exports[`gather list with places > print: the same table (A6 @media print rules) — snapshot with the place column and zone grouping 1`] = `"<div class="flex flex-wrap gap-2 mb-3" data-testid="gather-zone-summary"><span data-testid="gather-zone-chip" class="gather-zone-chip inline-flex items-center gap-1.5 rounded-full border border-line bg-elevated px-3 py-1 text-small text-primary"><bdi class="font-semibold">Zone Z1</bdi><span aria-hidden="true">·</span><span>5 pieces</span></span><span data-testid="gather-zone-chip" class="gather-zone-chip inline-flex items-center gap-1.5 rounded-full border border-line bg-elevated px-3 py-1 text-small text-primary"><bdi class="font-semibold">Zone Z2</bdi><span aria-hidden="true">·</span><span>2 pieces</span></span><span data-testid="gather-zone-chip" class="gather-zone-chip inline-flex items-center gap-1.5 rounded-full border border-line bg-elevated px-3 py-1 text-small text-primary"><bdi class="font-semibold">No place yet</bdi><span aria-hidden="true">·</span><span>3 pieces</span></span></div><table class="w-full" data-testid="gather-places-table"><thead class="bg-elevated border-b border-line"><tr><th class="tbl-header">Place</th><th class="tbl-header">Item</th><th class="tbl-header hidden sm:table-cell print:table-cell">SKU</th><th class="tbl-header text-end">Take</th><th class="tbl-header text-end">Available</th><th class="tbl-header hidden md:table-cell print:table-cell">Orders</th></tr></thead><tbody><tr class="gather-zone-row bg-elevated/60 border-b border-line" data-testid="gather-zone-row"><td colspan="6" class="tbl-cell py-1.5 text-small font-semibold text-primary"><bdi>Zone Z1</bdi></td></tr><tr data-testid="gather-place-row" class="tbl-row "><td class="tbl-cell"><p class="font-mono font-semibold text-primary whitespace-nowrap"><bdi>BOX-07</bdi></p><p class="text-caption text-muted">Box on shelf Z1-R01-S1</p><p class="text-caption text-muted">2 of 3 places</p></td><td class="tbl-cell"><p class="font-medium text-primary">Tee - M</p></td><td class="tbl-cell text-muted hidden sm:table-cell print:table-cell">TEE-M</td><td class="tbl-cell text-end font-mono">1</td><td class="tbl-cell text-end font-mono ">8</td><td class="tbl-cell text-muted hidden md:table-cell print:table-cell">#1, #2</td></tr><tr data-testid="gather-place-row" class="tbl-row "><td class="tbl-cell"><p class="font-mono font-semibold text-primary whitespace-nowrap"><bdi>Z1-R01-S2</bdi></p><p class="text-caption text-muted">1 of 3 places</p></td><td class="tbl-cell"><p class="font-medium text-primary">Tee - M</p></td><td class="tbl-cell text-muted hidden sm:table-cell print:table-cell">TEE-M</td><td class="tbl-cell text-end font-mono">3</td><td class="tbl-cell text-end font-mono ">8</td><td class="tbl-cell text-muted hidden md:table-cell print:table-cell">#1, #2</td></tr><tr data-testid="gather-place-row" class="tbl-row bg-critical/[0.14]"><td class="tbl-cell"><p class="font-mono font-semibold text-primary whitespace-nowrap"><bdi>Z1-R01-S10</bdi></p><p class="text-caption text-muted">1 of 2 places</p></td><td class="tbl-cell"><p class="font-medium text-primary">Tee - S</p><p class="text-caption text-critical-text">Short 2 — need 3, have 1</p></td><td class="tbl-cell text-muted hidden sm:table-cell print:table-cell">—</td><td class="tbl-cell text-end font-mono">1</td><td class="tbl-cell text-end font-mono text-critical-text font-semibold">1</td><td class="tbl-cell text-muted hidden md:table-cell print:table-cell">#4</td></tr><tr class="gather-zone-row bg-elevated/60 border-b border-line" data-testid="gather-zone-row"><td colspan="6" class="tbl-cell py-1.5 text-small font-semibold text-primary"><bdi>Zone Z2</bdi></td></tr><tr data-testid="gather-place-row" class="tbl-row "><td class="tbl-cell"><p class="font-mono font-semibold text-primary whitespace-nowrap"><bdi>BOX-02</bdi></p><p class="text-caption text-muted">On the Z2 floor</p></td><td class="tbl-cell"><p class="font-medium text-primary">Tee - L</p></td><td class="tbl-cell text-muted hidden sm:table-cell print:table-cell">TEE-L</td><td class="tbl-cell text-end font-mono">2</td><td class="tbl-cell text-end font-mono ">5</td><td class="tbl-cell text-muted hidden md:table-cell print:table-cell">#3</td></tr><tr class="gather-zone-row bg-elevated/60 border-b border-line" data-testid="gather-zone-row"><td colspan="6" class="tbl-cell py-1.5 text-small font-semibold text-primary"><bdi>No place yet</bdi></td></tr><tr data-testid="gather-place-row" class="tbl-row "><td class="tbl-cell"><p class="text-muted">No place yet</p><p class="text-caption text-muted">3 of 3 places</p></td><td class="tbl-cell"><p class="font-medium text-primary">Tee - M</p></td><td class="tbl-cell text-muted hidden sm:table-cell print:table-cell">TEE-M</td><td class="tbl-cell text-end font-mono">1</td><td class="tbl-cell text-end font-mono ">8</td><td class="tbl-cell text-muted hidden md:table-cell print:table-cell">#1, #2</td></tr><tr data-testid="gather-place-row" class="tbl-row bg-critical/[0.14]"><td class="tbl-cell"><p class="text-muted">No place yet</p><p class="text-caption text-muted">2 of 2 places</p></td><td class="tbl-cell"><p class="font-medium text-primary">Tee - S</p><p class="text-caption text-critical-text">Short 2 — need 3, have 1</p></td><td class="tbl-cell text-muted hidden sm:table-cell print:table-cell">—</td><td class="tbl-cell text-end font-mono">2</td><td class="tbl-cell text-end font-mono text-critical-text font-semibold">1</td><td class="tbl-cell text-muted hidden md:table-cell print:table-cell">#4</td></tr></tbody></table>"`;

exports[`off: places switched off > off: gather list renders exactly as before, no places request 1`] = `
"<div class="p-6 max-w-4xl mx-auto" data-testid="gather-list"><style>
        @media print {
          @page { size: A6; margin: 6mm; }

          .gather-no-print { display: none !important; }

          html, body {
            background: #ffffff !important;
            color: #111111 !important;
          }

          .text-primary { color: #111111 !important; }
          .text-muted   { color: #444444 !important; }
          .text-critical-text { color: #444444 !important; font-weight: 600; }

          /* .tbl-header/.tbl-cell bake text-muted/text-primary in via @apply — the
             literal class names above don't match these elements, so repeat the
             same override keyed to the compound class names actually present. */
          .tbl-header { color: #444444 !important; }
          .tbl-cell   { color: #111111 !important; }

          .card {
            background: #ffffff !important;
            border-color: #cccccc !important;
            box-shadow: none !important;
          }
          .bg-elevated { background: #f0f0f0 !important; }
          tr[class*="bg-critical"] { background: #f5f5f5 !important; }

          table, th, td, tr { border-color: #cccccc !important; }

          table { width: 100% !important; font-size: 10px; }
          th, td { padding: 3px 5px !important; }
        }
      </style><div class="flex items-center justify-between mb-2 gather-no-print"><div class="flex items-center gap-3"><button class="flex items-center gap-1.5 text-primary hover:bg-elevated transition-colors -ms-1 ps-2 pe-3 py-2 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg><span class="text-small font-semibold">Back to Queue</span></button><h1 class="text-h1 text-primary">Gather List</h1></div><div class="flex gap-2"><button type="button" class="btn rounded-xl transition-colors bg-transparent border border-line text-primary hover:bg-elevated hover:border-grey-300 active:bg-charcoal px-3 py-1.5 text-small gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>Refresh</button><button type="button" class="btn rounded-xl transition-colors bg-transparent border border-line text-primary hover:bg-elevated hover:border-grey-300 active:bg-charcoal px-3 py-1.5 text-small gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-printer" aria-hidden="true"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"></path><rect x="6" y="14" width="12" height="8" rx="1"></rect></svg>Print</button></div></div><h1 class="hidden print:block text-h1 text-primary mb-2">Gather List</h1><p class="text-small text-muted mb-6">4 order(s) ready to pick · Generated 10:00:00 AM</p><div class="card overflow-hidden p-0"><table class="w-full"><thead class="bg-elevated border-b border-line"><tr><th class="tbl-header">Item</th><th class="tbl-header hidden sm:table-cell print:table-cell">SKU</th><th class="tbl-header text-end">Needed</th><th class="tbl-header text-end">Available</th><th class="tbl-header hidden md:table-cell print:table-cell">Orders</th></tr></thead><tbody><tr class="tbl-row "><td class="tbl-cell"><p class="font-medium text-primary">Tee - M</p></td><td class="tbl-cell text-muted hidden sm:table-cell print:table-cell">TEE-M</td><td class="tbl-cell text-end font-mono">5</td><td class="tbl-cell text-end font-mono ">8</td><td class="tbl-cell text-muted hidden md:table-cell print:table-cell">#1, #2</td></tr><tr class="tbl-row "><td class="tbl-cell"><p class="font-medium text-primary">Tee - L</p></td><td class="tbl-cell text-muted hidden sm:table-cell print:table-cell">TEE-L</td><td class="tbl-cell text-end font-mono">2</td><td class="tbl-cell text-end font-mono ">5</td><td class="tbl-cell text-muted hidden md:table-cell print:table-cell">#3</td></tr><tr class="tbl-row bg-critical/[0.14]"><td class="tbl-cell"><p class="font-medium text-primary">Tee - S</p><p class="text-caption text-critical-text">Short 2 — need 3, have 1</p></td><td class="tbl-cell text-muted hidden sm:table-cell print:table-cell">—</td><td class="tbl-cell text-end font-mono">3</td><td class="tbl-cell text-end font-mono text-critical-text font-semibold">1</td><td class="tbl-cell text-muted hidden md:table-cell print:table-cell">#4</td></tr></tbody></table></div></div><div class="fixed bottom-4 end-4 z-dropdown flex flex-col gap-2 pointer-events-none"></div>"
`;

exports[`off: places switched off > off: pick screen renders exactly as before, no places request 1`] = `"<div class="flex flex-col h-screen bg-base" data-testid="fulfill-pick"><div class="hidden"></div><div class="bg-panel border-b border-line px-3 md:px-5 h-14 flex items-center gap-3 flex-shrink-0"><button class="flex items-center gap-1.5 text-primary hover:bg-elevated transition-colors flex-shrink-0 -ms-1 ps-2 pe-3 py-2 rounded-lg"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg><span class="text-small font-semibold">Back to Queue</span></button><p class="flex-1 text-body font-semibold text-primary flex items-center gap-2 truncate"><span class="font-mono">#101</span></p><button class="text-critical-text text-caption font-medium hover:opacity-80 transition-opacity flex-shrink-0">Cancel Order</button></div><div class="flex-1 flex flex-col md:flex-row overflow-hidden min-h-0"><div class="flex-1 md:border-e md:border-line overflow-y-auto order-2 md:order-1"><div class="flex-1 overflow-y-auto p-6 space-y-3"><div data-testid="pick-line-item-0" class="card p-3.5 flex items-start gap-3 md:gap-4  "><div class="bg-elevated border border-line flex items-center justify-center flex-shrink-0 overflow-hidden rounded-lg" style="width: 88px; height: 88px;"><div class="flex flex-col items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package text-muted" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><path d="m7.5 4.27 9 5.15"></path></svg></div></div><div class="flex-1 min-w-0"><div class="flex items-start justify-between gap-3 mb-2.5"><div class="min-w-0"><p class="text-body font-semibold text-primary break-words">Product 0</p><p class="text-caption text-muted font-mono break-words">SKU-0</p></div><span class="text-body font-mono font-semibold flex-shrink-0 text-muted">0/2</span></div><p class="text-caption text-muted">No pieces scanned yet</p></div></div><div data-testid="pick-line-item-1" class="card p-3.5 flex items-start gap-3 md:gap-4  "><div class="bg-elevated border border-line flex items-center justify-center flex-shrink-0 overflow-hidden rounded-lg" style="width: 88px; height: 88px;"><div class="flex flex-col items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package text-muted" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><path d="m7.5 4.27 9 5.15"></path></svg></div></div><div class="flex-1 min-w-0"><div class="flex items-start justify-between gap-3 mb-2.5"><div class="min-w-0"><p class="text-body font-semibold text-primary break-words">Product 1</p><p class="text-caption text-muted font-mono break-words">SKU-1</p></div><span class="text-body font-mono font-semibold flex-shrink-0 text-muted">0/1</span></div><p class="text-caption text-muted">No pieces scanned yet</p></div></div></div></div><div class="flex-shrink-0 md:w-[360px] md:flex md:flex-col md:p-5 md:gap-3.5 order-1 md:order-2"><div class="hidden md:flex flex-1 flex-col items-center justify-center gap-2 rounded-xl border text-center px-4 border-line bg-surface"><p class="text-small text-muted">No pieces scanned yet</p></div><div class="bg-panel md:bg-transparent border-b md:border-b-0 border-line px-6 md:px-0 py-4 md:py-0"><div class="relative"><span class="absolute start-3 top-1/2 -translate-y-1/2 text-trace-blue pointer-events-none"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scan-line" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M7 12h10"></path></svg></span><input type="text" placeholder="Scan or type barcode, then press Enter" class="input-scan w-full ps-10" aria-busy="false"></div></div></div></div><div class="bg-panel border-t border-line px-4 md:px-5 py-3.5 space-y-2 flex-shrink-0"><div class="space-y-1"><button disabled="" class="btn-outline btn text-small w-full opacity-40 cursor-not-allowed" data-testid="btn-print-awb">Print Waybill</button><p class="text-caption text-muted text-center" data-testid="awb-not-linked-note">Waybill not linked yet — the Bosta delivery hasn't synced.</p></div></div></div>"`;

exports[`off: places switched off > off: printed but not packed renders exactly as before, no places request 1`] = `"<section class="card p-5 space-y-3" data-testid="printed-not-packed"><div class="flex items-center justify-between"><h2 class="text-h3 text-primary">Printed but not packed</h2><span class="text-small text-muted">3 waybills</span></div><ul class="divide-y divide-line"><li data-testid="not-packed-row"><div class="py-3 flex items-center gap-3"><span class="min-w-0 flex-1"><span class="block text-body text-primary"><span class="font-mono font-semibold">#A</span><span> · A</span></span><span class="block text-small text-muted"><span class="font-mono">111</span> · Batch #1</span></span><span class="text-caption font-semibold rounded-full px-2.5 py-1 flex-shrink-0 bg-elevated text-muted" data-testid="status-waiting">Waiting</span></div></li><li data-testid="not-packed-row"><div class="py-3 flex items-center gap-3"><span class="min-w-0 flex-1"><span class="block text-body text-primary"><span class="font-mono font-semibold">#B</span><span> · B</span></span><span class="block text-small text-muted"><span class="font-mono">222</span> · Batch #1</span></span><span class="text-caption font-semibold rounded-full px-2.5 py-1 flex-shrink-0 bg-elevated text-muted" data-testid="status-waiting">Waiting</span></div></li><li data-testid="not-packed-row"><div class="py-3 flex items-center gap-3"><span class="min-w-0 flex-1"><span class="block text-body text-primary"><span class="font-mono font-semibold">#C</span><span> · C</span></span><span class="block text-small text-muted"><span class="font-mono">333</span> · Batch #1</span></span><span class="text-caption font-semibold rounded-full px-2.5 py-1 flex-shrink-0 bg-elevated text-muted" data-testid="status-waiting">Waiting</span></div></li></ul></section>"`;

exports[`off: places switched off > off: waybill order card renders exactly as before, no places request 1`] = `"<div class="flex flex-col lg:flex-row gap-4" data-testid="session-scanning"><div class="card p-4 lg:w-72 flex-shrink-0 space-y-2" data-testid="order-card"><p class="text-caption text-muted uppercase tracking-wide">Order</p><p class="text-h2 font-mono text-primary">#1047</p><p class="text-body text-primary">Youssef Adel</p><p class="text-small text-muted">Nasr City, Cairo</p><div class="pt-2 space-y-1 text-small text-muted border-t border-line"><p class="font-mono">Waybill 74821903</p><p>Courier Bosta · Delivery</p><p class="text-primary font-semibold">Cash on delivery EGP 1,250</p><p>Batch #3 · printed 10:42 AM</p></div><div class="pt-2"><button type="button" class="btn rounded-xl transition-colors bg-transparent border border-line text-primary hover:bg-elevated hover:border-grey-300 active:bg-charcoal px-3 py-1.5 text-small gap-1.5 w-full">Set aside this order</button></div></div><div class="flex-1 min-w-0 space-y-3"><div class="flex items-end justify-between gap-3"><div><p class="text-h3 text-primary">Scan the pieces</p><p class="text-small text-muted">The order closes by itself when the last piece is scanned.</p></div><p class="text-h4 font-mono text-primary">0 of 3</p></div><div class="h-2 rounded-full bg-elevated overflow-hidden"><div class="h-full bg-trace-blue transition-all" style="width: 0%;"></div></div><div class="space-y-2.5"><div><div data-testid="pack-line-line-1" class="card p-3.5 flex items-center gap-4"><div class="bg-elevated border border-line flex items-center justify-center flex-shrink-0 overflow-hidden rounded-lg" style="width: 88px; height: 88px;"><div class="flex flex-col items-center gap-1"><svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package text-muted" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><path d="m7.5 4.27 9 5.15"></path></svg></div></div><div class="flex-1 min-w-0"><p class="text-body font-semibold text-primary break-words">Linen shirt</p><p class="text-small text-muted break-words">Olive · M</p><p class="text-caption text-muted font-mono break-words">LS-OLV-M</p></div><div class="flex items-center gap-2 flex-shrink-0"><span class="text-h4 font-mono text-primary">0 / 3</span><span class="text-caption font-semibold text-trace-blue bg-trace-blue/[0.10] rounded-full px-2 py-0.5">3 more</span></div></div></div></div></div></div>"`;
